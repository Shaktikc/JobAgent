# --- AutoJobApply environment. Copy to `.env` and fill in. ---
# `.env` is gitignored - never commit it. Every value is optional; the defaults
# below are safe for the agent (Tasks 1-8).

# --- Browser session (browser-use; login persists in data/profile) ---
# AUTOJOB_SESSION_HEADLESS=false
# AUTOJOB_SESSION_VIEWPORT_WIDTH=1280
# AUTOJOB_SESSION_VIEWPORT_HEIGHT=800
# AUTOJOB_SESSION_USER_AGENT=
# AUTOJOB_SESSION_NAVIGATION_TIMEOUT_MS=60000

# --- Human login gate: how long to wait for you to log in, and poll rate ---
# AUTOJOB_SESSION_LOGIN_TIMEOUT_SECONDS=300
# AUTOJOB_SESSION_LOGIN_POLL_SECONDS=2.0

# Seconds to wait after clicking the Easy Apply filter before verifying it:
# AUTOJOB_SESSION_POST_CLICK_WAIT_SECONDS=2.0

# Task 2: seconds to wait for a job's apply button and then the Easy Apply form:
# AUTOJOB_SESSION_EASY_APPLY_TIMEOUT_SECONDS=20.0

# Task 2: seconds to wait for a clicked job card to appear in the job details pane
# before clicking it again. A click that misses leaves the pane on the previous
# (already-applied) job, whose pane has no Easy Apply button:
# AUTOJOB_SESSION_PANE_SWITCH_TIMEOUT_SECONDS=6.0

# Task 1: seconds to keep looking for LinkedIn's optional "Try AI job search"
# control after the results load (0 = check once, don't wait):
# AUTOJOB_SESSION_AI_SEARCH_TIMEOUT_SECONDS=5.0

# Slow-motion: seconds to pause between visible steps (0 = off). Set this to a
# few seconds to watch the flow run in the browser.
# AUTOJOB_SESSION_STEP_DELAY_SECONDS=0

# Before launching, close any leftover browser still holding data/profile (e.g.
# from an interrupted run) and clear its single-instance lock file, so the new
# launch can open its own CDP port. Set false to manage this yourself.
# AUTOJOB_SESSION_CLEAN_STALE_PROFILE=true

# Task 6: skip job cards already marked "Applied" and open the next unapplied
# job instead. Set false to open the first Easy Apply card regardless.
# AUTOJOB_SESSION_SKIP_APPLIED=true

# Task 4: when the form reaches its last step (only "Submit application" is left),
# the browser is left open so you can review and submit manually. The run waits
# for you to close the window, then finishes. Seconds to wait before it stops
# waiting and leaves the browser open for you (0 = wait indefinitely), and how
# often to check. The agent never closes the browser; use `autojob --clean-profile`
# to force-close a leftover one:
# AUTOJOB_SESSION_KEEP_OPEN_TIMEOUT_SECONDS=1800
# AUTOJOB_SESSION_KEEP_OPEN_POLL_SECONDS=1.0

# Task 8: after you submit a job, the agent returns to the results list, opens the
# next unapplied job, and repeats the whole process (open Easy Apply -> read the
# description -> match a resume -> fill -> wait for you to submit again) until it
# stops. How many jobs one run may submit before the loop stops (0 = keep going
# until no unapplied job remains). The agent never clicks Submit:
# AUTOJOB_SESSION_MAX_JOBS=5

# Task 11: self-healing loop. When a fill crashes or a dynamic form step stops
# advancing, the agent records a failure bundle + BUG-NNN entry, closes the
# browser, reopens the same job, and re-fills it. Attempts are capped; on
# exhaustion the evidence is preserved and the run stops.
# AUTOJOB_SELF_HEAL_ENABLED=true
# AUTOJOB_SELF_HEAL_MAX_ATTEMPTS=3
# Optional repair hook: hand the evidence bundle to the OpenCode agent so it fixes
# the code, then guard reopening with tests. It runs AFTER the failed browser is
# closed, with AUTOJOB_FAILURE_BUNDLE, AUTOJOB_FAILURE_REPORT,
# AUTOJOB_FAILURE_FINGERPRINT, AUTOJOB_FAILURE_CATEGORY, and AUTOJOB_BUG_ID in the
# environment. The test command then runs before the browser is reopened; a failing
# test stops the loop instead of patching again. Browser/fill modules are reloaded
# after a successful repair/test; changes to graph/node/state modules still require
# a normal agent restart. The wrapper runs
# `opencode run --auto --file <report> "<prompt>"` in the project root; it reuses
# AUTOJOB_LLM_MODEL for the repair session (mapped to OpenCode's `openrouter/...`
# id). Set AUTOJOB_SELF_HEAL_REPAIR_MODEL / ..._AGENT to override the session, and
# AUTOJOB_SELF_HEAL_OPENCODE to point at a CLI that is not on PATH.
# AUTOJOB_SELF_HEAL_REPAIR_COMMAND=uv run python scripts/self_heal_repair.py
# AUTOJOB_SELF_HEAL_TEST_COMMAND=uv run pytest -q
# An agentic repair needs headroom; this timeout also bounds the test run:
# AUTOJOB_SELF_HEAL_COMMAND_TIMEOUT_SECONDS=3600
# AUTOJOB_SELF_HEAL_CLOSE_TIMEOUT_SECONDS=20

# Keep the Chromium profile and failure screenshots here:
# AUTOJOB_DATA_DIR=./data

# Task 3: folder of resumes (.pdf, .docx, .txt, .md) to choose from:
# AUTOJOB_RESUMES_DIR=./resumes

# Task 3: the LLM (Task 3.2) writes a short profile for every resume and picks
# the best match for the job, or `none`. Task 3.1: when nothing matches, pause and
# ask you to upload a resume in the browser; it is stored in the folder, described
# by the LLM, and remembered for similar jobs.
# Job profile -> remembered resume store written by Task 3.1:
# AUTOJOB_RESUME_LIBRARY=./data/resume_library.json

# Task 3.2: the LLM-written profile for each resume (skills, titles, seniority,
# years, domain), keyed by the resume's path. The LLM also picks the best match
# from these descriptions — there is no deterministic scoring fallback:
# AUTOJOB_RESUME_DESCRIPTIONS=./data/resume_descriptions.json

# --- LLM: OpenRouter (required for Task 4.1) ---
# Task 4.1 asks this model to classify each Easy Apply question and choose the
# right answer from the store below. It is required: without a key + model, no
# answer is chosen and every question is handed to Task 5 (ask the human).
# OPENROUTER_API_KEY=sk-or-...
# AUTOJOB_LLM_MODEL=deepseek/deepseek-v4.1-flash
# Optional: any OpenAI-compatible endpoint (default is OpenRouter):
# AUTOJOB_LLM_BASE_URL=https://openrouter.ai/api/v1
# AUTOJOB_LLM_TEMPERATURE=0
# AUTOJOB_LLM_TIMEOUT_SECONDS=60
# AUTOJOB_LLM_MAX_RETRIES=3
# Task 3.2: skip the model's hidden reasoning for the structured description and
# match calls. Default true; it makes the resume match fast (seconds, not
# minutes) and avoids an empty reply when reasoning fills the output budget.
# AUTOJOB_LLM_DISABLE_REASONING=true

# Task 4: question -> answer store (default ./data/answers.json). Task 4.1/10's LLM
# reads it and answers each question (copying a stored answer or deriving one the
# stored entries entail, always citing the stored key(s) it used); Task 5 writes
# new human-confirmed answers here.
# AUTOJOB_ANSWERS_FILE=./data/answers.json

# Task 10.3: cache of answers the LLM *derived* from the store (default
# ./data/derived_answers.json). Kept separate so answers.json stays
# human-confirmed; a changed source store makes a cached entry re-derive.
# AUTOJOB_DERIVED_ANSWERS_FILE=./data/derived_answers.json

# Task 3.1 / Task 5: when the agent cannot pick a resume or answer a question,
# pause and ask you through a banner in the browser window, then remember it. Set
# to false to skip asking.
# AUTOJOB_SESSION_ASK_HUMAN=true
# How long to wait for your answer before giving up:
# AUTOJOB_SESSION_ASK_TIMEOUT_SECONDS=300
# How often to check the browser banner for your answer:
# AUTOJOB_SESSION_ASK_POLL_SECONDS=1.0
