# Copy to .env and replace the API key. Never commit .env.

# LLM provider and models
OPENROUTER_API_KEY=your_openrouter_api_key_here
AUTOJOB_LLM_MODEL=xiaomi/mimo-v2.6-pro
# Leave task overrides blank to use AUTOJOB_LLM_MODEL.
AUTOJOB_RESUME_LLM_MODEL=xiaomi/mimo-v2.6-pro
AUTOJOB_ANSWERS_LLM_MODEL=xiaomi/mimo-v2.6-pro
# Optional: OpenRouter is the default endpoint.
# AUTOJOB_LLM_BASE_URL=https://openrouter.ai/api/v1

# Self-healing (optional; repair requires OpenCode)
AUTOJOB_SELF_HEAL_ENABLED=false
AUTOJOB_SELF_HEAL_REPAIR_MODEL=deepseek/deepseek-v4.1-flash-1017
AUTOJOB_SELF_HEAL_REPAIR_COMMAND=uv run python scripts/self_heal_repair.py
AUTOJOB_SELF_HEAL_TEST_COMMAND=uv run pytest -q
AUTOJOB_SELF_HEAL_COMMAND_TIMEOUT_SECONDS=3600

# Optional browser and storage settings (shown with defaults)
# AUTOJOB_SESSION_HEADLESS=false
# AUTOJOB_SESSION_MAX_JOBS=35
# AUTOJOB_SESSION_REQUIRE_RESUME_MATCH=true
# AUTOJOB_SESSION_ASK_HUMAN=true
# AUTOJOB_DATA_DIR=./data
# AUTOJOB_RESUMES_DIR=./resumes
# AUTOJOB_NEW_RESUMES_DIR=./resumes/new
# AUTOJOB_ANSWERS_FILE=./data/answers.json
