# AutoJobApply environment. Copy to `.env` and fill in. `.env` is gitignored.

# --- LLM: OpenRouter (required) ---
OPENROUTER_API_KEY=
AUTOJOB_LLM_MODEL=

# --- Optional overrides ---
# AUTOJOB_LLM_TEMPERATURE=0
# AUTOJOB_LLM_TIMEOUT_SECONDS=60
# AUTOJOB_LLM_MAX_RETRIES=3

# --- Guard (see SPEC.md §7; changing these is an "ask first" action) ---
# AUTOJOB_GUARD_DAILY_CAP=30
# AUTOJOB_GUARD_HOURS_START=09:00
# AUTOJOB_GUARD_HOURS_END=18:00
# AUTOJOB_GUARD_MIN_DELAY_SECONDS=20
# AUTOJOB_GUARD_MAX_DELAY_SECONDS=90
